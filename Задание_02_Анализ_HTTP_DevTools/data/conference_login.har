          "content": {
            "size": 3455,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"csrf-token\" content=\"[токен скрыт]\">\n    <meta name=\"description\" content=\"Конференции.РФ — бронирование помещений для проведения Всероссийских конференций\">\n    <title>Авторизация — Конференции.РФ</title>\n    <link rel=\"icon\" type=\"image/png\" href=\"/static/img/logo-32.png\">\n    <link rel=\"preload\" href=\"/static/fonts/PTSans-Regular.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n    <link rel=\"stylesheet\" href=\"/static/css/style.css\">\n</head>\n<body>\n<header class=\"header\">\n    <div class=\"container header__inner\">\n        <a class=\"logo\" href=\"/\">\n            <img src=\"/static/img/logo-64.png\" width=\"36\" height=\"36\" alt=\"\">\n            <span>Конференции<b>.РФ</b></span>\n        </a>\n        <button class=\"burger\" type=\"button\" aria-label=\"Меню\" aria-expanded=\"false\" data-burger><span></span></button>\n        <nav class=\"nav\" data-nav>\n            \n            <a href=\"/\" class=\"\">Помещения</a>\n            \n                <a href=\"/login\" class=\"active\">Вход</a>\n                <a href=\"/register\" class=\"\">Регистрация</a>\n            \n        </nav>\n    </div>\n</header>\n\n<main>\n    <div class=\"container page\" data-page>\n        \n<section class=\"auth card\">\n    <h1>Авторизация</h1>\n    <form class=\"form\" id=\"login-form\" novalidate>\n        <div class=\"form-alert\" data-form-alert hidden></div>\n        <div class=\"field\">\n            <label for=\"login\">Логин</label>\n            <input id=\"login\" name=\"login\" autocomplete=\"username\" maxlength=\"50\" required>\n            <div class=\"field__error\" data-error-for=\"login\"></div>\n        </div>\n        <div class=\"field\">\n            <label for=\"password\">Пароль</label>\n            <div class=\"pwd\">\n                <input id=\"password\" name=\"password\" type=\"password\" autocomplete=\"current-password\" maxlength=\"128\" required>\n                <button class=\"pwd__toggle\" type=\"button\" data-toggle-pwd=\"password\" aria-label=\"Показать пароль\">👁</button>\n            </div>\n            <div class=\"field__error\" data-error-for=\"password\"></div>\n        </div>\n        <button class=\"btn btn--primary btn--block\" type=\"submit\">Войти</button>\n        <p class=\"form-switch\">Еще не зарегистрированы? <a href=\"/register\">Регистрация</a></p>\n    </form>\n</section>\n\n    </div>\n</main>\n\n<footer class=\"footer\">\n    <div class=\"container footer__inner\">\n        <span>© 2027 Конференции.РФ — бронирование помещений для Всероссийских конференций</span>\n        <div class=\"social\">\n            <a href=\"#\" aria-label=\"ВКонтакте\"><img src=\"/static/img/social-vk.png\" width=\"32\" height=\"32\" alt=\"ВКонтакте\" loading=\"lazy\"></a>\n            <a href=\"#\" aria-label=\"Одноклассники\"><img src=\"/static/img/social-ok.png\" width=\"32\" height=\"32\" alt=\"Одноклассники\" loading=\"lazy\"></a>\n        </div>\n    </div>\n</footer>\n\n<div class=\"toasts\" data-toasts aria-live=\"polite\"></div>\n<script src=\"/static/js/common.js\" defer></script>\n<script src=\"/static/js/login.js\" defer></script>\n</body>\n</html>"
