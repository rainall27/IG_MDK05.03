            "mimeType": "text/html",
            "compression": 0,
            "text": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"csrf-token\" content=\"TYaQNXsTx-GbDMeVoHBYZ-ynFhhCd9UghOLsd4mhfow\">\n    <meta name=\"description\" content=\"Конференции.РФ — бронирование помещений для проведения Всероссийских конференций\">\n    <title>Панель администратора — Конференции.РФ</title>\n    <link rel=\"icon\" type=\"image/png\" href=\"/static/img/logo-32.png\">\n    <link rel=\"preload\" href=\"/static/fonts/PTSans-Regular.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n    <link rel=\"stylesheet\" href=\"/static/css/style.css\">\n</head>\n<body>\n<header class=\"header\">\n    <div class=\"container header__inner\">\n        <a class=\"logo\" href=\"/\">\n            <img src=\"/static/img/logo-64.png\" width=\"36\" height=\"36\" alt=\"\">\n            <span>Конференции<b>.РФ</b></span>\n        </a>\n        <button class=\"burger\" type=\"button\" aria-label=\"Меню\" aria-expanded=\"false\" data-burger><span></span></button>\n        <nav class=\"nav\" data-nav>\n            \n            <a href=\"/\" class=\"\">Помещения</a>\n            \n                \n                    <a href=\"/admin\" class=\"active\">Панель администратора</a>\n                \n                <span class=\"nav__user\">Conf2027</span>\n                <form action=\"/logout\" method=\"post\">\n                    <input type=\"hidden\" name=\"csrf_token\" value=\"TYaQNXsTx-GbDMeVoHBYZ-ynFhhCd9UghOLsd4mhfow\">\n                    <button class=\"link-btn\" type=\"submit\" data-testid=\"logout\">Выйти</button>\n                </form>\n            \n        </nav>\n    </div>\n</header>\n\n<main>\n    <div class=\"container page\" data-page>\n        \n<div class=\"page-head\">\n    <h1>Панель администратора</h1>\n    <span class=\"hint\">Все заявки зарегистрированных пользователей</span>\n</div>\n\n<div class=\"stats\" data-stats>\n    <div class=\"stat\"><b data-stat=\"1\">3</b><span>Новые</span></div>\n    <div class=\"stat\"><b data-stat=\"2\">6</b><span>Назначены</span></div>\n    <div class=\"stat\"><b data-stat=\"3\">3</b><span>Завершены</span></div>\n</div>\n\n<form class=\"filters\" id=\"filters\" novalidate>\n    <select name=\"status\" aria-label=\"Статус\">\n        <option value=\"\">Все статусы</option>\n        <option value=\"1\">Новая</option><option value=\"2\">Мероприятие назначено</option><option value=\"3\">Завершено</option>\n    </select>\n    <select name=\"room\" aria-label=\"Помещение\">\n        <option value=\"\">Все помещения</option>\n        <option value=\"1\">Аудитория</option><option value=\"2\">Коворкинг</option><option value=\"3\">Кинозал</option>\n    </select>\n    <input class=\"filters__search\" name=\"q\" type=\"search\" placeholder=\"Поиск по логину или ФИО\" aria-label=\"Поиск\">\n    <input name=\"from\" type=\"date\" aria-label=\"Начало с\">\n    <input name=\"to\" type=\"date\" aria-label=\"Начало по\">\n    <button class=\"btn btn--outline btn--sm\" type=\"reset\">Сбросить</button>\n</form>\n\n<div class=\"grid grid--3\" data-admin-list data-statuses='[{\"id\": 1, \"name\": \"\\u041d\\u043e\\u0432\\u0430\\u044f\"}, {\"id\": 2, \"name\": \"\\u041c\\u0435\\u0440\\u043e\\u043f\\u0440\\u0438\\u044f\\u0442\\u0438\\u0435 \\u043d\\u0430\\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u043e\"}, {\"id\": 3, \"name\": \"\\u0417\\u0430\\u0432\\u0435\\u0440\\u0448\\u0435\\u043d\\u043e\"}]'></div>\n<div class=\"card empty\" data-admin-empty hidden>Заявок по выбранным условиям нет.</div>\n\n    </div>\n</main>\n\n<footer class=\"footer\">\n    <div class=\"container footer__inner\">\n        <span>© 2027 Конференции.РФ — бронирование помещений для Всероссийских конференций</span>\n        <div class=\"social\">\n            <a href=\"#\" aria-label=\"ВКонтакте\"><img src=\"/static/img/social-vk.png\" width=\"32\" height=\"32\" alt=\"ВКонтакте\" loading=\"lazy\"></a>\n            <a href=\"#\" aria-label=\"Одноклассники\"><img src=\"/static/img/social-ok.png\" width=\"32\" height=\"32\" alt=\"Одноклассники\" loading=\"lazy\"></a>\n        </div>\n    </div>\n</footer>\n\n<div class=\"toasts\" data-toasts aria-live=\"polite\"></div>\n<script src=\"/static/js/common.js\" defer></script>\n<script src=\"/static/js/admin.js\" defer></script>\n</body>\n</html>"
