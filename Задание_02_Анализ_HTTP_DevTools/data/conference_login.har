          "content": {
            "size": 17358,
            "mimeType": "text/css",
            "text": "/* =============================================================\n   Конференции.РФ — стили\n   Фирменный стиль заказчика (Руководство по стилю):\n   голубой #007bff, тёмно-синий #0d47a1, серый #6c757d,\n   фон #f8f9fa, выделяющий #ffffff; шрифт PT Sans.\n   Вёрстка mobile-first: базовые стили для смартфона 390×844,\n   медиа-запросы расширяют макет для планшета и ПК.\n   ============================================================= */\n\n@font-face { font-family: 'PT Sans'; src: url('../fonts/PTSans-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }\n@font-face { font-family: 'PT Sans'; src: url('../fonts/PTSans-Bold.woff2') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }\n@font-face { font-family: 'PT Sans'; src: url('../fonts/PTSans-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }\n/* Шрифтовая пара: PT Sans (весь текст) + Inter (цифры в счётчиках админ-панели). Inter урезан до латиницы и цифр. */\n@font-face { font-family: 'Inter'; src: url('../fonts/Inter-Bold-subset.woff2') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }\n\n:root {\n    --blue: #007bff;\n    --blue-dark: #0d47a1;\n    --gray: #6c757d;\n    --bg: #f8f9fa;\n    --white: #ffffff;\n    --text: #1d2733;\n    --line: #dee2e6;\n    --danger: #c62828;\n    --success: #2e7d32;\n    --warning: #b26a00;\n    --radius: 12px;\n    --shadow: 0 2px 10px rgba(13, 71, 161, .08);\n    --shadow-hover: 0 10px 24px rgba(13, 71, 161, .16);\n    --ease: cubic-bezier(.2, .7, .2, 1);\n}\n\n*, *::before, *::after { box-sizing: border-box; }\n\nhtml { -webkit-text-size-adjust: 100%; }\n\nbody {\n    margin: 0;\n    font-family: 'PT Sans', Arial, sans-serif;\n    font-size: 16px;\n    line-height: 1.5;\n    color: var(--text);\n    background: var(--bg);\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n}\n\nh1, h2, h3 { font-weight: 700; color: var(--blue-dark); line-height: 1.2; margin: 0 0 .6em; }\nh1 { font-size: 28px; }\nh2 { font-size: 22px; }\nh3 { font-size: 18px; }\np { margin: 0 0 1em; }\na { color: var(--blue); text-decoration: none; }\na:hover { text-decoration: underline; }\nimg { max-width: 100%; height: auto; display: block; }\n\n.hint, small, .muted { font-size: 12px; font-style: italic; color: var(--gray); }\n\n.container { width: 100%; max-width: 1140px; margin: 0 auto; padding: 0 16px; }\n\n/* ---------- шапка ---------- */\n.header { background: var(--white); box-shadow: var(--shadow); position: sticky; top: 0; z-index: 20; }\n.header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 60px; gap: 12px; }\n.logo { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 20px; color: var(--blue-dark); }\n.logo:hover { text-decoration: none; }\n.logo img { width: 36px; height: 36px; }\n.logo span b { color: var(--blue); }\n\n.burger { width: 44px; height: 44px; border: 0; background: transparent; border-radius: 8px; cursor: pointer; display: grid; place-items: center; }\n.burger span, .burger span::before, .burger span::after { display: block; width: 22px; height: 2px; background: var(--blue-dark); position: relative; transition: transform .25s var(--ease), background .25s; }\n.burger span::before, .burger span::after { content: ''; position: absolute; left: 0; }\n.burger span::before { top: -7px; }\n.burger span::after { top: 7px; }\n.nav-open .burger span { background: transparent; }\n.nav-open .burger span::before { transform: translateY(7px) rotate(45deg); }\n.nav-open .burger span::after { transform: translateY(-7px) rotate(-45deg); }\n\n.nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--white); box-shadow: var(--shadow);\n       display: flex; flex-direction: column; padding: 8px 16px 16px; gap: 4px;\n       transform: translateY(-8px); opacity: 0; visibility: hidden; transition: opacity .2s, transform .2s var(--ease), visibility .2s; }\n.nav-open .nav { opacity: 1; transform: none; visibility: visible; }\n.nav a, .nav button { padding: 10px 12px; border-radius: 8px; color: var(--text); font: inherit; text-align: left; }\n.nav a:hover { background: var(--bg); text-decoration: none; }\n.nav a.active { color: var(--blue); font-weight: 700; }\n.nav__user { font-size: 12px; font-style: italic; color: var(--gray); padding: 8px 12px 0; }\n.nav form { margin: 0; }\n.nav .link-btn { background: none; border: 0; cursor: pointer; width: 100%; }\n.nav .link-btn:hover { background: var(--bg); }\n\n/* ---------- основное ---------- */\nmain { flex: 1; padding: 24px 0 40px; }\n.page { animation: page-in .35s var(--ease) both; }\n.page-leave { animation: page-out .18s ease-in both; }\n@keyframes page-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }\n@keyframes page-out { to { opacity: 0; transform: translateY(-6px); } }\n\n.page-head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px; }\n.page-head h1 { margin: 0; }\n\n/* ---------- кнопки ---------- */\n.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 10px 20px;\n       border-radius: 10px; border: 2px solid transparent; font: 700 16px/1 'PT Sans', Arial, sans-serif; cursor: pointer;\n       transition: transform .15s var(--ease), box-shadow .2s, background-color .2s, color .2s; text-decoration: none; }\n.btn:hover { text-decoration: none; transform: translateY(-2px); box-shadow: var(--shadow-hover); }\n.btn:active { transform: translateY(0) scale(.97); box-shadow: none; }\n.btn:focus-visible { outline: 3px solid rgba(0, 123, 255, .35); outline-offset: 2px; }\n.btn--primary { background: var(--blue); color: var(--white); }\n.btn--primary:hover { background: var(--blue-dark); }\n.btn--outline { background: var(--white); color: var(--blue); border-color: var(--blue); }\n.btn--outline:hover { background: var(--blue); color: var(--white); }\n.btn--block { width: 100%; }\n.btn--sm { min-height: 36px; padding: 6px 14px; font-size: 14px; }\n.btn[disabled] { opacity: .6; cursor: progress; transform: none; box-shadow: none; }\n.btn.is-loading::after { content: ''; width: 16px; height: 16px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin .7s linear infinite; }\n@keyframes spin { to { transform: rotate(360deg); } }\n\n/* ---------- карточки ---------- */\n.card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px;\n        transition: transform .25s var(--ease), box-shadow .25s; }\n.card--hover:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }\n\n.grid { display: grid; gap: 16px; grid-template-columns: 1fr; }\n\n/* ---------- главная ---------- */\n.hero { position: relative; border-radius: var(--radius); overflow: hidden; color: var(--white); margin-bottom: 28px; min-height: 260px; display: flex; align-items: flex-end; }\n.hero img, .hero picture { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n.hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13,71,161,.15) 0%, rgba(13,71,161,.88) 100%); }\n.hero__body { position: relative; z-index: 1; padding: 24px; }\n.hero h1 { color: var(--white); }\n.hero p { max-width: 560px; }\n.hero__actions { display: flex; flex-wrap: wrap; gap: 10px; }\n.hero .btn--outline { background: transparent; color: var(--white); border-color: var(--white); }\n.hero .btn--outline:hover { background: var(--white); color: var(--blue-dark); }\n\n.room { padding: 0; overflow: hidden; }\n.room__img { aspect-ratio: 16 / 10; width: 100%; object-fit: cover; transition: transform .5s var(--ease); }\n.room:hover .room__img { transform: scale(1.05); }\n.room__body { padding: 16px 20px 20px; }\n.room__meta { display: flex; justify-content: space-between; align-items: center; }\n\n/* ---------- формы ---------- */\n.auth { max-width: 460px; margin: 0 auto; }\n.form { display: flex; flex-direction: column; gap: 14px; }\n.field { display: flex; flex-direction: column; gap: 6px; }\n.field label { font-weight: 700; }\n.field input, .field select, .field textarea, .filters input, .filters select {\n    width: 100%; min-height: 44px; padding: 10px 12px; font: 16px 'PT Sans', Arial, sans-serif; color: var(--text);\n    background: var(--white); border: 1px solid #ced4da; border-radius: 10px; transition: border-color .2s, box-shadow .2s; }\n.field textarea { min-height: 96px; resize: vertical; }\n.field input:focus, .field select:focus, .field textarea:focus, .filters input:focus, .filters select:focus {\n    outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(0, 123, 255, .2); }\n.field.has-error input, .field.has-error select, .field.has-error textarea { border-color: var(--danger); animation: shake .35s; }\n.field.is-valid input, .field.is-valid select { border-color: var(--success); }\n.field__error { min-height: 18px; font-size: 13px; color: var(--danger); }\n.field__error:empty { min-height: 0; }\n@keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }\n\n.form-alert { padding: 12px 14px; border-radius: 10px; background: #fdecea; color: var(--danger); font-weight: 700; animation: page-in .25s var(--ease); }\n.form-alert[hidden] { display: none; }\n.form-switch { text-align: center; margin: 4px 0 0; }\n\n.pwd { position: relative; }\n.pwd input { padding-right: 48px; }\n.pwd__toggle { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); width: 40px; height: 36px; border: 0; background: none; cursor: pointer; color: var(--gray); font-size: 13px; }\n\n/* выбор помещения карточками-радиокнопками */\n.room-pick { position: relative; display: grid; gap: 10px; grid-template-columns: 1fr; }\n.room-pick input { position: absolute; left: 0; top: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; }\n.room-pick label { display: flex; gap: 12px; align-items: center; padding: 8px; border: 2px solid var(--line); border-radius: 12px; cursor: pointer; background: var(--white);\n                   transition: border-color .2s, box-shadow .2s, transform .15s; font-weight: 400; }\n.room-pick label:hover { border-color: var(--blue); }\n.room-pick img { width: 72px; height: 52px; object-fit: cover; border-radius: 8px; }\n.room-pick input:checked + label { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(0, 123, 255, .2); }\n.room-pick input:focus-visible + label { outline: 3px solid rgba(0, 123, 255, .35); }\n\n/* ---------- заявки ---------- */\n.req { display: flex; flex-direction: column; gap: 10px; animation: page-in .35s var(--ease) both; }\n.req__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }\n.req__title { font-weight: 700; font-size: 18px; color: var(--blue-dark); margin: 0; }\n.req__list { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; }\n.req__list dt { color: var(--gray); }\n.req__list dd { margin: 0; font-weight: 700; }\n\n.badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 13px; font-weight: 700; white-space: nowrap; }\n.badge--1 { background: #e3f2fd; color: var(--blue-dark); }\n.badge--2 { background: #fff4e5; color: var(--warning); }\n.badge--3 { background: #e8f5e9; color: var(--success); }\n\n.review { border-top: 1px dashed var(--line); padding-top: 10px; }\n.review__text { margin: 4px 0 0; }\n.stars { position: relative; display: inline-flex; flex-direction: row-reverse; justify-content: flex-end; gap: 2px; }\n.stars input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }\n.stars label { font-size: 28px; line-height: 1; color: #ced4da; cursor: pointer; transition: color .15s, transform .15s; }\n.stars label:hover, .stars label:hover ~ label, .stars input:checked ~ label { color: #f5a623; }\n.stars label:active { transform: scale(1.25); }\n.rating-view { color: #f5a623; letter-spacing: 2px; }\n\n.empty { text-align: center; padding: 40px 20px; color: var(--gray); }\n\n/* ---------- личный кабинет ---------- */\n.profile { display: grid; gap: 16px; grid-template-columns: 1fr; }\n.profile__head { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }\n.avatar { width: 64px; height: 64px; border-radius: 50%; background: var(--blue); color: var(--white); display: grid; place-items: center; font-size: 26px; font-weight: 700; flex-shrink: 0; }\n.profile__name { margin: 0; }\n.profile .stats { margin-bottom: 0; grid-template-columns: repeat(2, 1fr); }\n.next-event { display: flex; gap: 12px; align-items: center; padding: 12px 14px; border-radius: 10px; background: #e3f2fd; color: var(--blue-dark); }\n.actions { display: flex; flex-wrap: wrap; gap: 10px; }\n\n/* ---------- админ-панель ---------- */\n.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }\n.stat { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); padding: 12px; text-align: center; }\n.stat b { display: block; font-family: 'Inter', 'PT Sans', sans-serif; font-size: 26px; color: var(--blue-dark); transition: transform .3s var(--ease); }\n.stat b.bump { animation: bump .4s var(--ease); }\n.stat span { font-size: 12px; color: var(--gray); }\n@keyframes bump { 50% { transform: scale(1.3); color: var(--blue); } }\n\n.filters { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; margin-bottom: 18px; }\n.filters .filters__search { grid-column: 1 / -1; }\n.filters .btn { grid-column: 1 / -1; }\n.status-change { display: flex; gap: 8px; }\n.status-change select { flex: 1; min-height: 36px; padding: 6px 10px; border: 1px solid #ced4da; border-radius: 8px; font: 14px 'PT Sans', Arial, sans-serif; }\n.req--updated { animation: flash 1s ease; }\n@keyframes flash { 0% { box-shadow: 0 0 0 4px rgba(46, 125, 50, .5); } 100% { box-shadow: var(--shadow); } }\n\n/* ---------- уведомления ---------- */\n.toasts { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 50; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }\n.toast { background: var(--blue-dark); color: var(--white); padding: 12px 16px; border-radius: 10px; box-shadow: var(--shadow-hover);\n         animation: toast-in .3s var(--ease) both; pointer-events: auto; }\n.toast--error { background: var(--danger); }\n.toast.hide { animation: toast-out .25s ease-in both; }\n@keyframes toast-in { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }\n@keyframes toast-out { to { opacity: 0; transform: translateY(20px); } }\n\n/* ---------- подвал ---------- */\n.footer { background: var(--blue-dark); color: rgba(255, 255, 255, .85); padding: 20px 0; font-size: 14px; }\n.footer__inner { display: flex; flex-direction: column; gap: 12px; align-items: center; text-align: center; }\n.footer .social { display: flex; gap: 10px; }\n.footer .social img { width: 32px; height: 32px; border-radius: 8px; transition: transform .2s var(--ease); }\n.footer .social a:hover img { transform: translateY(-3px) scale(1.08); }\n\n.error-page { text-align: center; padding: 60px 0; }\n.error-page b { display: block; font-size: 72px; color: var(--blue); }\n\n/* =============== планшет =============== */\n@media (min-width: 768px) {\n    h1 { font-size: 36px; }\n    h2 { font-size: 24px; }\n    .grid--2, .grid--3 { grid-template-columns: repeat(2, 1fr); }\n    .page-head { flex-direction: row; justify-content: space-between; align-items: center; }\n    .hero { min-height: 340px; }\n    .hero__body { padding: 40px; }\n    .room-pick { grid-template-columns: repeat(3, 1fr); }\n    .room-pick label { flex-direction: column; align-items: stretch; text-align: center; }\n    .room-pick img { width: 100%; height: 100px; }\n    .filters { grid-template-columns: repeat(4, 1fr); }\n    .filters .filters__search { grid-column: span 2; }\n    .filters .btn { grid-column: span 2; }\n    .toasts { left: auto; width: 360px; }\n    .profile { grid-template-columns: 1fr 1fr; }\n    .profile .stats { grid-template-columns: repeat(4, 1fr); }\n    .profile__stats { grid-column: 1 / -1; }\n    .footer__inner { flex-direction: row; justify-content: space-between; text-align: left; }\n}\n\n/* =============== ПК =============== */\n@media (min-width: 992px) {\n    .burger { display: none; }\n    .nav { position: static; flex-direction: row; align-items: center; padding: 0; box-shadow: none; opacity: 1; visibility: visible; transform: none; background: none; }\n    .nav__user { padding: 0 8px; }\n    .nav .link-btn { width: auto; }\n    .grid--3 { grid-template-columns: repeat(3, 1fr); }\n    .filters { grid-template-columns: 1fr 1fr 2fr 1fr 1fr auto; }\n    .filters .filters__search { grid-column: span 1; }\n    .filters .btn { grid-column: span 1; align-self: stretch; }\n}\n\n/* Уважение к настройке «уменьшить движение» */\n@media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }\n}\n"
